<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>IKnowText</AssemblyName>
    <RootNamespace>SnapActions</RootNamespace>
    <Product>IKnowText</Product>
    <AssemblyTitle>IKnowText</AssemblyTitle>
    <Description>IKnowText — 基于 SnapActions v2.4.5 的本地化改造版</Description>
    <Version>2.4.5</Version>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <!-- We're WPF-primary (WinForms is only NotifyIcon). The manifest's PerMonitorV2 declaration
         is what the OS reads at process startup. WinForms' WFO0003 wants its own DPI hook. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed the icon so single-file publish can load it from the assembly -->
    <Resource Include="app.ico"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="iNKORE.UI.WPF.Modern" Version="0.10.2.1" />
    <PackageReference Include="Jint" Version="4.16.4" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.DependencyInjection" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test project needs to call internal helpers like WebSearchAction.BuildUrl -->
    <InternalsVisibleTo Include="SnapActions.Tests"/>
  </ItemGroup>

  <ItemGroup>
    <!-- 发行包要随附第三方许可（MIT 要求保留版权声明）：licenses\ 与 LICENSE 一起复制到输出/发布目录。
         注意别再写 <Content Remove="..\licenses\**" /> —— 那会把刚 Include 进来的文件又移除掉，
         导致发布包里只剩 exe，用户拿不到许可声明。 -->
    <Content Include="..\licenses\*" Link="licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\LICENSE" Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
