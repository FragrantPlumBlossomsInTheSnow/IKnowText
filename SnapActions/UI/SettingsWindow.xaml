<ui:FluentWindow x:Class="SnapActions.UI.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:SnapActions.UI"
                 FontSize="13" Title="IKnowText 设置" Width="740" Height="740" MinWidth="620" MinHeight="500"
                 WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <!-- Expander 内设置项之间的 1px 分隔线（效仿 Windows 设置） -->
        <Style x:Key="SettingDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <!-- 设置项统一行样式（Expander/卡片内每项间距一致，本身不再各自写 Margin） -->
        <Style x:Key="SettingCheckBoxStyle" TargetType="CheckBox"
               BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SettingRowStyle" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="WpfUiComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="Padding" Value="10, 4" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style x:Key="WpfUiButtonStyle" TargetType="ui:Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="WpfUiTextBoxStyle" TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,4,0,4" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="100" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style x:Key="WpfUiTextBlockStyle" TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="WpfUiCardStyle" TargetType="ui:Card"
               BasedOn="{StaticResource {x:Type ui:Card}}">
            <Setter Property="Padding" Value="10,10,40,10" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="WpfUiExpanderStyle" TargetType="Expander"
               BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- 左侧导航项：Win11 设置导航风格 —— 图标+文字，选中项左侧主题色指示条 + 圆角高亮块，
             hover 淡色垫底。ListBox 天然单选，避免了 MenuItem IsCheckable 的翻转问题。 -->
        <Style x:Key="SettingsNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="indicator" Width="3" HorizontalAlignment="Left"
                                    Margin="0,12,8,12" CornerRadius="1.5"
                                    Background="{DynamicResource SystemFillColorAttentionBrush}"
                                    Visibility="Collapsed" />
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="12,8">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="indicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsSelected" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 自绘标题栏：ExtendsContentIntoTitleBar=True 后客户区延伸到标题栏，需自行承载拖拽与关闭 -->
        <Border Grid.Row="0" Height="34" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <DockPanel Margin="14,0,10,0">
                <ui:Button Cursor="Hand" DockPanel.Dock="Right" Click="Close_Click" Width="36" Height="26"
                           Margin="6,0,0,0" Padding="0" ToolTip="关闭" Content="✕"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="IKnowText 设置" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,6,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="8*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="SettingsNavList" Grid.Column="0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         ItemContainerStyle="{StaticResource SettingsNavItemStyle}"
                         SelectionChanged="SettingsNav_SelectionChanged">
                    <ListBoxItem Tag="general" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="{x:Static local:IconGlyphs.Settings}" FontSize="18" Margin="0,0,10,0"
                                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="通用" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="actions">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="{x:Static local:IconGlyphs.Context}" FontSize="18"
                                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="动作" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="language">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="{x:Static local:IconGlyphs.TranslateTab}" FontSize="18"
                                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="翻译" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="custom">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="{x:Static local:IconGlyphs.Add}" FontSize="18"
                                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="自定义" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="apps">
                        <StackPanel Orientation="Horizontal">
                            <ui:FontIcon Glyph="{x:Static local:IconGlyphs.Apps}" FontSize="18"
                                         FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                            <TextBlock Text="应用" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
                <!-- 右侧内容区：与左侧菜单对应，NavItem_Click 中按 Tag 切换可见性 -->
                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <!-- General -->
                            <ui:Card Style="{StaticResource WpfUiCardStyle}">
                                <DockPanel>
                                    <TextBlock Text="主题" Style="{StaticResource WpfUiTextBlockStyle}"
                                               DockPanel.Dock="Left" />
                                    <ComboBox x:Name="ThemeCombo" Style="{StaticResource WpfUiComboBoxStyle}"
                                              AutomationProperties.Name="Color theme" SelectionChanged="Theme_Changed"
                                              DockPanel.Dock="Right">
                                        <ComboBoxItem Content="跟随系统设置" Tag="system" />
                                        <ComboBoxItem Content="浅色" Tag="light" />
                                        <ComboBoxItem Content="深色" Tag="dark" />
                                    </ComboBox>
                                </DockPanel>
                            </ui:Card>
                            <Expander IsExpanded="True" Header="应用行为" Style="{StaticResource WpfUiExpanderStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="AutoStartCheck" Content="开机自启"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="AutoStart_Changed" Unchecked="AutoStart_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />

                                    <CheckBox x:Name="EnabledCheck" Content="启用工具栏"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />

                                    <CheckBox x:Name="SelectCopyCheck" Content="划词即复制"
                                              ToolTip="立即将划词选中的文本放入剪贴板，可以直接粘贴，支持复制的程序基本都能生效"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                </StackPanel>
                            </Expander>
                            <Expander IsExpanded="True" Header="工具栏行为" Style="{StaticResource WpfUiExpanderStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="OnlineLookupsCheck"
                                              Content="允许在线查找（翻译/网络请求）"
                                              ToolTip="允许翻译将选中文本发送到翻译API，允许Javascript脚本使用网络请求。否则，发送请求前会想你询问"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <CheckBox x:Name="CaptureOnCtrlCCheck"
                                              Content="按Ctrl+C时显示工具栏"
                                              ToolTip="启用此选项后，使用Ctrl+C复制文本也会弹出工具栏。这会读取您刚才复制的内容——无需合成按键，也无需清除剪贴板——因此不会干扰其他应用程序。"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <CheckBox x:Name="HoverOpenCheck"
                                              Content="悬停展开子窗口"
                                              ToolTip="鼠标悬停到工具栏的（文本转换和编码/解码）项时自动展开子窗口"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <CheckBox x:Name="UseSyntheticKeys"
                                              Content="允许发送合成键"
                                              ToolTip="启用此选项后，会使用合成按键保证工具栏能够在大部分情况下弹出，但会短暂修改你的剪切板，也会影响部分程序的使用体验"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />

                                </StackPanel>
                            </Expander>
                            <Expander Header="工具栏计时" Style="{StaticResource WpfUiExpanderStyle}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="显示延迟："
                                                   DockPanel.Dock="Left"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="ShowDelayCombo" Style="{StaticResource WpfUiComboBoxStyle}"
                                                  DockPanel.Dock="Right"
                                                  SelectionChanged="ShowDelay_Changed"
                                                  AutomationProperties.Name="ShowDelayCombo">
                                            <ComboBoxItem Content="立即" Tag="0" />
                                            <ComboBoxItem Content="100毫秒" Tag="100" />
                                            <ComboBoxItem Content="200毫秒" Tag="200" />
                                            <ComboBoxItem Content="300毫秒" Tag="300" />
                                            <ComboBoxItem Content="500毫秒" Tag="500" />
                                            <ComboBoxItem Content="1秒" Tag="1000" />
                                        </ComboBox>
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingDivider}" />

                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="多点单击显示延迟："
                                                   DockPanel.Dock="Left"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="MultiClickCombo" Style="{StaticResource WpfUiComboBoxStyle}"
                                                  DockPanel.Dock="Right"
                                                  SelectionChanged="MultiClick_Changed"
                                                  AutomationProperties.Name="MultiClickCombo">
                                            <ComboBoxItem Content="立即" Tag="0" />
                                            <ComboBoxItem Content="100毫秒" Tag="100" />
                                            <ComboBoxItem Content="200毫秒" Tag="200" />
                                            <ComboBoxItem Content="300毫秒" Tag="300" />
                                            <ComboBoxItem Content="400毫秒" Tag="400" />
                                        </ComboBox>
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingDivider}" />

                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="自动关闭时间："
                                                   DockPanel.Dock="Left"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox x:Name="DismissTimeCombo" Style="{StaticResource WpfUiComboBoxStyle}"
                                                  DockPanel.Dock="Right"
                                                  SelectionChanged="DismissTime_Changed"
                                                  AutomationProperties.Name="DismissTimeCombo">
                                            <ComboBoxItem Content="3秒后" Tag="3000" />
                                            <ComboBoxItem Content="5秒后" Tag="5000" />
                                            <ComboBoxItem Content="8秒后" Tag="8000" />
                                            <ComboBoxItem Content="15秒后" Tag="15000" />
                                            <ComboBoxItem Content="30秒后" Tag="30000" />
                                            <ComboBoxItem Content="从不" Tag="0" />
                                        </ComboBox>
                                    </DockPanel>

                                </StackPanel>
                            </Expander>

                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="ActionsPage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <!-- Action Categories -->
                            <ui:Card Style="{StaticResource WpfUiCardStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="最大显示建议动作的数量"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ComboBox DockPanel.Dock="Right" x:Name="MaxInlineCombo"
                                                  Style="{StaticResource WpfUiComboBoxStyle}"
                                                  SelectionChanged="MaxInline_Changed"
                                                  ToolTip="立即应用于每个应用程序，包括浏览器。固定动作不计入此限制。"
                                                  AutomationProperties.Name="Suggested actions on toolbar">
                                            <ComboBoxItem Content="1" Tag="1" />
                                            <ComboBoxItem Content="2" Tag="2" />
                                            <ComboBoxItem Content="3" Tag="3" />
                                            <ComboBoxItem Content="4" Tag="4" />
                                            <ComboBoxItem Content="6" Tag="6" />
                                            <ComboBoxItem Content="8" Tag="8" />
                                        </ComboBox>
                                    </DockPanel>
                                </StackPanel>
                            </ui:Card>
                            <Expander Header="固定在工具栏的动作" Style="{StaticResource WpfUiExpanderStyle}">
                                <StackPanel x:Name="PinnedActions" Margin="0,0,0,4" />
                            </Expander>
                            <Expander IsExpanded="True" Header="启用动作" Style="{StaticResource WpfUiExpanderStyle}">
                                <StackPanel>
                                    <CheckBox x:Name="ShowPasteCheck" Content="粘贴"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <CheckBox x:Name="ShowTranslateCheck" Content="翻译"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <CheckBox x:Name="ShowTransformCheck" Content="文本转换"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <CheckBox x:Name="ShowEncodeCheck" Content="编码/解码"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <CheckBox x:Name="ShowSearchCheck" Content="网页搜索"
                                              Style="{StaticResource SettingCheckBoxStyle}"
                                              Checked="Setting_Changed" Unchecked="Setting_Changed" />
                                </StackPanel>
                            </Expander>

                            <!-- Search Engines -->
                            <Expander Header="启用搜索" Style="{StaticResource WpfUiExpanderStyle}">
                                <StackPanel x:Name="SearchEnginesPanel" Margin="0,0,0,4" />
                            </Expander>

                            <!-- Add custom search engine -->
                            <ui:Card Style="{StaticResource WpfUiCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="添加自定义搜索" Style="{StaticResource WpfUiTextBlockStyle}" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="名称：" DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ui:TextBox x:Name="CustomNameBox"
                                                    HorizontalAlignment="Right"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource WpfUiTextBoxStyle}"
                                                    AutomationProperties.Name="CustomNameBox" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="URL:" DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ui:TextBox x:Name="CustomUrlBox"
                                                    HorizontalAlignment="Right"
                                                    DockPanel.Dock="Right"
                                                    Style="{StaticResource WpfUiTextBoxStyle}"
                                                    AutomationProperties.Name="CustomUrlBox" />
                                    </DockPanel>
                                    <TextBlock
                                        Text="｛0｝为选中的文本。例子：https://cn.bing.com/search?q={0}"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        TextWrapping="Wrap" />
                                    <ui:Button Content="添加" HorizontalAlignment="Left"
                                               Click="AddCustomEngine_Click"
                                               Style="{StaticResource WpfUiButtonStyle}" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="LanguagePage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <Expander Header="翻译项" IsExpanded="True" Style="{StaticResource WpfUiExpanderStyle}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="源语言"
                                                   DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ComboBox DockPanel.Dock="Right"
                                                  x:Name="TranslationSourceCombo"
                                                  Style="{StaticResource WpfUiComboBoxStyle}"
                                                  AutomationProperties.Name="Translation source language"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Code"
                                                  SelectionChanged="LookupLanguage_Changed" />
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="目标语言"
                                                   DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ComboBox DockPanel.Dock="Right"
                                                  x:Name="TranslationTargetCombo"
                                                  Style="{StaticResource WpfUiComboBoxStyle}"
                                                  AutomationProperties.Name="Translation target language"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Code"
                                                  SelectionChanged="LookupLanguage_Changed" />
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="源语言为Windows系统语言时，翻译输出的语言"
                                                   DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ComboBox DockPanel.Dock="Right"
                                                  x:Name="SystemTargetCombo"
                                                  Style="{StaticResource WpfUiComboBoxStyle}"
                                                  AutomationProperties.Name="System-language translation target"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Code"
                                                  SelectionChanged="LookupLanguage_Changed" />
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="内容忽略正则表达式"
                                                   ToolTip="翻译前将表达式匹配的内容删除"
                                                   DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <TextBox x:Name="ExclusionTextRegex"
                                                 TextChanged="ExcludeRegex_Changed"
                                                 HorizontalAlignment="Right"
                                                 DockPanel.Dock="Right"
                                                 Style="{StaticResource WpfUiTextBoxStyle}"
                                                 AutomationProperties.Name="Translation text regex" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <Expander x:Name="BaiduExpander" Header="百度翻译凭据"
                                      Style="{StaticResource WpfUiExpanderStyle}">
                                <StackPanel>
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="APP ID"
                                                   DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ui:TextBox DockPanel.Dock="Right"
                                                    x:Name="BaiduAppIdBox"
                                                    Style="{StaticResource WpfUiTextBoxStyle}"
                                                    AutomationProperties.Name="Baidu App ID"
                                                    TextChanged="BaiduAppId_Changed"
                                                    HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="密钥（不是API Key）"
                                                   DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ui:PasswordBox DockPanel.Dock="Right"
                                                        x:Name="BaiduSecretBox"
                                                        Style="{StaticResource WpfUiTextBoxStyle}"
                                                        AutomationProperties.Name="Baidu Secret Key"
                                                        PasswordChanged="BaiduSecret_Changed"
                                                        HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <Border Style="{StaticResource SettingDivider}" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text=""
                                                   DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ui:Button DockPanel.Dock="Right" Content="申请百度翻译凭据"
                                                   Style="{StaticResource WpfUiButtonStyle}"
                                                   Click="ApplyForBaiduTranslate_Click"
                                                   HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Expander>

                            <TextBlock Text="自定义翻译" Style="{StaticResource TitleText}" Margin="0,20,0,0" />
                            <ui:Card Style="{StaticResource WpfUiCardStyle}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="使用Javascript请求其他翻译服务，默认使用百度翻译" />
                                    <DockPanel Style="{StaticResource SettingRowStyle}">
                                        <TextBlock Text="默认引擎"
                                                   DockPanel.Dock="Left"
                                                   Style="{StaticResource WpfUiTextBlockStyle}" />
                                        <ComboBox x:Name="TranslationEngineCombo"
                                                  DockPanel.Dock="Right" Width="220" HorizontalAlignment="Right"
                                                  SelectionChanged="TranslationEngine_Changed"
                                                  AutomationProperties.Name="默认翻译引擎" />
                                    </DockPanel>
                                    <StackPanel x:Name="TranslationEnginesPanel" Margin="0,8,0,0" />
                                    <ui:Button Content="添加翻译引擎" HorizontalAlignment="Left" Margin="0,8,0,0"
                                               Style="{StaticResource WpfUiButtonStyle}"
                                               Click="AddTranslationEngine_Click" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="CustomPage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <!-- 自定义操作（UserRecipeAction）已停用：设置入口移除，功能默认关闭。 -->

                            <TextBlock Text="文本转换方案" Style="{StaticResource TitleText}" />
                            <ui:Card Style="{StaticResource WpfUiCardStyle}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="创建复合文本转换方案，并添加到「文本转换」子窗口中使用" />
                                    <StackPanel x:Name="RecipesPanel" Margin="0,8" />
                                    <ui:Button Content="创建方案" HorizontalAlignment="Left"
                                               Style="{StaticResource WpfUiButtonStyle}"
                                               Click="CreateRecipe_Click" />
                                </StackPanel>
                            </ui:Card>

                            <TextBlock Text="JS 脚本动作" Style="{StaticResource TitleText}" Margin="0,20,0,0" />
                            <ui:Card Style="{StaticResource WpfUiCardStyle}">
                                <StackPanel>
                                    <TextBlock TextWrapping="Wrap"
                                               Text="使用Javascript自定义专属的文本转换脚本" />
                                    <StackPanel x:Name="ScriptActionsPanel" Margin="0,8" />
                                    <ui:Button Content="添加脚本动作" HorizontalAlignment="Left"
                                               Style="{StaticResource WpfUiButtonStyle}"
                                               Click="AddScriptAction_Click" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer x:Name="AppsPage" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16">
                            <!-- Excluded Apps -->
                            <TextBlock Text="排除的应用程序" Style="{StaticResource TitleText}" />
                            <TextBlock Text="建议将游戏排除" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <ui:Card Style="{StaticResource WpfUiCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <ui:Button DockPanel.Dock="Right" Content="添加正在运行的应用程序..."
                                                   Style="{StaticResource WpfUiButtonStyle}"
                                                   Margin="5,0 0,0"
                                                   Click="AddRunningApp_Click" Cursor="Hand" />
                                        <TextBlock Text="每行一个进程名称"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ui:TextBox x:Name="ExcludedAppsBox" AcceptsReturn="True" MinHeight="120"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                Padding="8" FontFamily="Consolas" FontSize="12"
                                                TextChanged="ExcludedApps_Changed"
                                                AutomationProperties.Name="ExcludedAppsBox" />
                                </StackPanel>
                            </ui:Card>
                            <TextBlock Text="合成兜底白名单" Style="{StaticResource TitleText}" />
                            <TextBlock Text="只有进入白名单的程序才会触发合成键兜底" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <ui:Card Style="{StaticResource WpfUiCardStyle}">
                                <StackPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <ui:Button DockPanel.Dock="Right" Content="添加正在运行的应用程序..."
                                                   Style="{StaticResource WpfUiButtonStyle}"
                                                   Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                   Click="AddSyntheticWhitelistApp_Click" Cursor="Hand" />
                                        <TextBlock Text="每行一个进程名称"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ui:TextBox x:Name="SyntheticWhitelistBox" AcceptsReturn="True" MinHeight="100"
                                                Margin="0,8,0,0"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                Padding="8" FontFamily="Consolas" FontSize="12"
                                                TextChanged="SyntheticWhitelist_Changed"
                                                AutomationProperties.Name="SyntheticFallbackWhitelistBox" />
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SaveStatusText" Text="自动保存更改"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="VersionText" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="RetrySaveButton" Content="重试保存" Visibility="Collapsed" Click="Save_Click"
                               Style="{StaticResource WpfUiButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>