<Window x:Class="SnapActions.UI.UserScriptEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JS 脚本动作" Width="720" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <!-- JS 脚本动作编辑器：名称 → 脚本 → 「上下文触发」正则 → 即时试跑（结果 + console 日志）。
         行为全在 UserScriptEditor.xaml.cs：Code_Changed / Sample_Changed 触发 Preview()，
         Trigger_Changed 刷新正则提示，保存前校验正则与试跑。 -->
    <ScrollViewer VerticalScrollBarVisibility="Visible">
        
        <StackPanel Margin="20">
            <TextBlock Text="动作名称" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Padding="8" MaxLength="80"
                     AutomationProperties.Name="脚本动作名称" />

            <TextBlock Text="Javascript 脚本（必须定义函数 JSAction(text)，返回值即结果文本）" Margin="0,14,0,6" />
            <Button Content="生成 JSAction(text)" Click="GenerateJSAction_Click" Padding="8, 3" Margin="0,0,0, 6" />
            <TextBox x:Name="CodeBox" FontFamily="Consolas" AcceptsReturn="True" AcceptsTab="True"
                     MinHeight="260"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="2,6"
                     AutomationProperties.Name="脚本源码" TextChanged="Code_Changed" />
            <TextBlock x:Name="SandboxHintText" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="注意：脚本无法访问文件/网络/剪贴板；单次执行限时 2 秒，输出上限 128K 字符。" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="可用 console.log，输出只在「console 输出」显示" />

            <CheckBox x:Name="AllowNetworkCheck" Margin="0,12,0,0"
                      Content="允许此脚本访问网络（http）"
                      AutomationProperties.Name="允许此脚本访问网络"
                      Checked="AllowNetwork_Changed" Unchecked="AllowNetwork_Changed" />
            <!-- 文案在 UserScriptEditor.xaml.cs 的 UpdateSandboxHint 里按开关状态切换。
                 自定义翻译引擎有自己的编辑器 TranslationEngineEditor（必联网）。 -->
            <TextBlock x:Name="NetworkHintText" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Visibility="Collapsed"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="试跑文本" Margin="0,14,0,6" />
            <!-- 默认试跑文本在 UserScriptEditor.xaml.cs 里赋值：写在 XAML 会在控件创建到一半时触发 TextChanged。 -->
            <TextBox x:Name="SampleBox" AcceptsReturn="True" Height="60" TextWrapping="Wrap" Padding="2,6"
                     MaxLength="4096" AutomationProperties.Name="试跑文本" TextChanged="Sample_Changed" />

            <TextBlock Text="上下文触发（正则，可选）" Margin="0,14,0,6" />
            <TextBox x:Name="TriggerBox" MaxLength="2048" Padding="2,6"
                     AutomationProperties.Name="上下文触发正则" TextChanged="Trigger_Changed" />
            <TextBlock x:Name="TriggerHintText" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            
            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="当选中文本与正则匹配时，会向工具栏推送当前JS动作" />

            <TextBlock Text="return 输出" Margin="0,14,0,6" />
            <TextBox x:Name="PreviewBox" IsReadOnly="True" MinHeight="80" TextWrapping="Wrap"
                     Padding="2,6"
                     AutomationProperties.Name="脚本试跑预览" />
            <TextBlock Text="console 输出" Margin="0,10,0,6" />
            <TextBox x:Name="LogsBox" IsReadOnly="True" MinHeight="70" MaxHeight="150" TextWrapping="Wrap"
                     Padding="2,6"
                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"
                     AutomationProperties.Name="脚本试跑日志" />

            <TextBlock x:Name="StatusText" Margin="0,16,0,0" TextWrapping="Wrap" HorizontalAlignment="Right" />
            <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Right">
                <Button Content="取消" Padding="8,5" Margin="4,3,0,3" Cursor="Hand" Click="Cancel_Click" />
                <Button Content="保存" Padding="8,5" Margin="4,3,0,3" Cursor="Hand" Click="Save_Click" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Window>