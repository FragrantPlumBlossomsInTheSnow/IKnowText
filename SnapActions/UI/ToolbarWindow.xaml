<Window x:Class="SnapActions.UI.ToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:modern="http://schemas.inkore.net/lib/ui/wpf/modern"
        xmlns:local="clr-namespace:SnapActions.UI"
        xmlns:actions="clr-namespace:SnapActions.Actions"
        Title="SnapActions toolbar"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Opacity="1">

    <Window.Resources>
        <!-- 淡入淡出：PositionAndShow/FadeOut 及 Show 末尾都通过 FindResource 引用，
             删掉会让工具栏弹出时抛"未找到 FadeOut 资源"（ResourceReferenceKeyNotFoundException）。 -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainBorder"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="4" To="0" Duration="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.06"/>
        </Storyboard>
    </Window.Resources>

    <!-- Grid separates the toolbar from the popup so popup can't affect toolbar layout -->
    <Grid>
        <!-- MainBorder carries its own rounded drop shadow. It is OPAQUE (a translucent surface
             would itself be shadowed and produce a rectangular halo), and the Margin leaves
             window space around it so the blur renders fully instead of being clipped at the
             window edge. PositionAndShow anchors on MainBorder to undo this margin. -->
        <Border x:Name="MainBorder"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="4" MaxWidth="600"
                Margin="10" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" Opacity="0.30" ShadowDepth="3" Color="#000000" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>

            <StackPanel Orientation="Vertical">
                <Border x:Name="TypeBadge" Visibility="Collapsed"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        CornerRadius="4" Padding="6,2" Margin="2,2,2,4"
                        HorizontalAlignment="Left">
                    <TextBlock x:Name="TypeLabel" FontSize="11"
                               Foreground="{DynamicResource SystemFillColorAttentionBrush}" FontWeight="SemiBold" />
                </Border>

                <StackPanel x:Name="MainToolbar" Orientation="Horizontal">
                    <!-- Drag handle: move the whole toolbar. Stays at the leading edge. -->
                    <Button x:Name="DragHandle" Style="{StaticResource DragHandleButtonStyle}"
                            ToolTip="拖动移动工具栏"
                            PreviewMouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                            PreviewMouseMove="DragHandle_MouseMove"
                            PreviewMouseLeftButtonUp="DragHandle_MouseLeftButtonUp">
                        <modern:FontIcon Glyph="{x:Static local:IconGlyphs.DragHandle}" FontSize="14"
                                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>

                    <Button x:Name="CopyButton" Style="{StaticResource ActionButtonStyle}"
                            ToolTip="复制" Click="CopyButton_Click">
                        <modern:FontIcon Glyph="{x:Static local:IconGlyphs.Copy}" FontSize="18"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Button>

                    <Button x:Name="PasteButton" Style="{StaticResource ActionButtonStyle}"
                            ToolTip="粘贴" Click="PasteButton_Click">
                        <modern:FontIcon Glyph="{x:Static local:IconGlyphs.Paste}" FontSize="18"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Button>

                    <!-- 删除按钮已停用（用户注释保留，恢复时取消注释即可） -->
                    <!--
                    <Button x:Name="DeleteButton" Style="{StaticResource ActionButtonStyle}"
                            ToolTip="删除选中文本" Click="DeleteButton_Click">
                        <modern:FontIcon Glyph="{x:Static local:IconGlyphs.Delete}" FontSize="18"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Button>
                    -->

                    <Border x:Name="TranslateSeparator" Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="TranslationButton"
                            Style="{StaticResource ActionButtonStyle}"
                            ToolTip="翻译" Click="TranslationButton_Click"
                            Tag="{x:Static actions:ActionCategory.Translate}">
                        <Grid Width="24" Height="24">
                            <!-- <modern:FontIcon Glyph="{x:Static local:IconGlyphs.TranslateSta}" FontSize="18" -->
                            <!--                  Foreground="{DynamicResource TextFillColorPrimaryBrush}" -->
                            <!--                  HorizontalAlignment="Left" VerticalAlignment="Top" /> -->
                            <TextBlock Text="文" FontSize="14" FontWeight="500"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <modern:FontIcon Glyph="{x:Static local:IconGlyphs.TranslateEn}" FontSize="14"
                                             Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <!-- 上下文动作 -->
                    <Border x:Name="ContextSeparator" Style="{StaticResource ToolbarSeparator}" Visibility="Collapsed" />
                    <StackPanel x:Name="ContextActionsPanel" Orientation="Horizontal" />

                    <!-- 固定行动 (user-selected favorites) -->
                    <Border x:Name="PinnedSeparator" Style="{StaticResource ToolbarSeparator}" Visibility="Collapsed" />
                    <StackPanel x:Name="PinnedActionsPanel" Orientation="Horizontal" />
                    
                    <Border x:Name="TransformSeparator" Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="TransformButton"
                            Style="{StaticResource CategoryButtonStyle}"
                            Tag="{x:Static actions:ActionCategory.Transform}"
                            Click="TransformButton_Click"
                            MouseEnter="CategoryButton_Enter"
                            MouseLeave="CategoryButton_Leave"
                            ToolTip="文本转换">
                        <Grid Width="24" Height="24">
                            <modern:FontIcon Glyph="{x:Static local:IconGlyphs.Transform}" FontSize="18"
                                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <modern:FontIcon Glyph="{x:Static local:IconGlyphs.RightBottomExpand}" FontSize="6"
                                             Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>
                    <Button x:Name="EncodeButton"
                            Style="{StaticResource CategoryButtonStyle}"
                            Tag="{x:Static actions:ActionCategory.Encode}"
                            Click="EncodeButton_Click"
                            MouseEnter="CategoryButton_Enter"
                            MouseLeave="CategoryButton_Leave"
                            ToolTip="编码/解码">
                        <Grid Width="24" Height="24">
                            <TextBlock Text="&lt;/&gt;" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <modern:FontIcon Glyph="{x:Static local:IconGlyphs.RightBottomExpand}" FontSize="6"
                                             Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Button>

                    <Border x:Name="SearchSeparator" Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="SearchButton" Style="{StaticResource ActionButtonStyle}"
                            Click="SearchButton_Click" ToolTip="搜索">
                        <modern:FontIcon Glyph="{x:Static local:IconGlyphs.Search}" FontSize="18"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Button>

                    <Button x:Name="MoreButton" AutomationProperties.Name="More actions"
                            Visibility="Collapsed" Click="MoreButton_Click"
                            Style="{StaticResource ActionButtonStyle}">
                        <modern:FontIcon Glyph="{x:Static local:IconGlyphs.More}" FontSize="18"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="PinDropIndicator" Width="2" Background="{DynamicResource SystemFillColorAttentionBrush}"
                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />

        <!-- Popup is outside the Border so opening it cannot affect toolbar layout/size -->
        <Popup x:Name="SubMenuPopup" StaysOpen="True" AllowsTransparency="True"
               PopupAnimation="Fade" Placement="Bottom" PlacementTarget="{Binding ElementName=MainBorder}"
               HorizontalOffset="0" VerticalOffset="8">
            <modern:DropShadowPanel BlurRadius="14" CornerRadius="12" Margin="0,5,8,8">
                <!-- Fluent popover card: near-opaque surface, soft shadow, 1px border, larger radius -->
                <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="11" Padding="5"
                        MinWidth="200" MaxWidth="600" MaxHeight="380">
                    <StackPanel>
                        <DockPanel x:Name="SubMenuHeader" Margin="6,4,2,6">
                            <Button x:Name="GearButton" Style="{StaticResource ActionButtonStyle}"
                                    DockPanel.Dock="Right" Width="24" Height="24" Margin="3,0"
                                    ToolTip="切换操作" Click="GearButton_Click">
                                <modern:FontIcon Glyph="{x:Static local:IconGlyphs.Settings}" FontSize="14"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Button>
                            <TextBlock x:Name="SubMenuTitle" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="CustomizationHint" FontSize="10" Margin="6,0,6,6" MaxWidth="450"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="拖到工具栏上以固定。右键点击取消固定。" />
                        <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                                Margin="2,0,2,4" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="170">
                            <!-- 4 列自适应网格；列定义与条目由 ClearSubMenu/AddSubMenuItem 按 SubMenuColumns 重建 -->
                            <Grid x:Name="SubMenuPanel" Margin="0,0,10,0" />
                        </ScrollViewer>
                        <Border x:Name="PreviewBorder"
                                Background="{DynamicResource ApplicationBackgroundBrush}"
                                CornerRadius="7" Padding="10,6" Margin="4,6,4,2"
                                Height="32" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="1" Visibility="Hidden">
                            <DockPanel VerticalAlignment="Center">
                                <Border x:Name="ColorSwatch" Width="16" Height="16" CornerRadius="3"
                                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        Margin="0,0,8,0" Visibility="Collapsed" />
                                <TextBlock x:Name="PreviewText" FontSize="12" Opacity="0"
                                           Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                           FontFamily="Consolas" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </modern:DropShadowPanel>
        </Popup>

        <!-- 翻译弹层：挂在工具栏窗口上（替代独立 TranslationPopup 窗口，纯 XAML 渲染百度翻译
             结果，不使用 WebView）。StaysOpen=True，由外部点击/Esc/关闭按钮收起；打开期间
             暂停 dismiss timer，避免阅读结果时工具栏被自动隐藏。 -->
        <Popup x:Name="TranslatePopup" StaysOpen="True" AllowsTransparency="True"
               PopupAnimation="Fade" Placement="Bottom" PlacementTarget="{Binding ElementName=MainBorder}"
               HorizontalOffset="0" VerticalOffset="8">
            <modern:DropShadowPanel BlurRadius="14" CornerRadius="12" Margin="0,5,8,8">
                <Border x:Name="TranslateCard"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="10"
                        Width="420"
                        Height="400"
                        MinWidth="260"
                        MinHeight="180">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="翻译结果" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SystemFillColorAttentionBrush}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="TranslateCloseButton" Padding="2" Margin="0,0,0,0"
                                    HorizontalAlignment="Right" AutomationProperties.Name="Close translation"
                                    Click="TranslateClose_Click" Background="Transparent"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    BorderThickness="0" Cursor="Hand">
                                <modern:FontIcon Glyph="{x:Static local:IconGlyphs.Close}" FontSize="16"
                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Button>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="TranslateSourceCombo" Width="120" Height="30" Padding="12,5"
                                      DisplayMemberPath="Name" SelectedValuePath="Code"
                                      SelectionChanged="TranslateLanguage_Changed" />
                            <TextBlock Text="→" VerticalAlignment="Center" Margin="8,0"
                                       FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ComboBox x:Name="TranslateTargetCombo" Width="120" Height="30" Padding="12,5"
                                      DisplayMemberPath="Name" SelectedValuePath="Code"
                                      Margin="0,0,8,0" SelectionChanged="TranslateLanguage_Changed" />
                            <Button x:Name="TranslateRetryButton" Content="重新翻译" Height="30" Padding="12,5"
                                    Click="TranslateRetry_Click" Cursor="Hand"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        </StackPanel>

                        <TextBlock x:Name="TranslateStatusText" Grid.Row="2" Text="正在翻译..." TextWrapping="Wrap"
                                   Height="30"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"
                                   Margin="0,0,0,6" Visibility="Collapsed" />

                        <TextBox x:Name="TranslateResultBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="14" MinHeight="120"
                                 Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                 Padding="8" BorderThickness="1" />

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="TranslateCopyButton" Content="复制结果" Padding="12,5" Margin="0,0,8,0"
                                    Click="TranslateCopy_Click" Cursor="Hand"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Button x:Name="TranslateWriteButton" Content="替换原文" Padding="12,5"
                                    Click="TranslateWrite_Click" Cursor="Hand"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" />
                        </StackPanel>
                        
                        <Thumb Grid.Row="0" x:Name="TranslateResizeThumb" Grid.RowSpan="5"
                               Width="18" Height="18"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Cursor="SizeNWSE" Background="Transparent"
                               ToolTip="拖动调整大小"
                               DragDelta="TranslateResizeThumb_DragDelta">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent">
                                        <!-- 三条斜线，模仿 Windows 的缩放握把 -->
                                        <Path Data="M 14,6 L 6,14 M 14,10 L 10,14 M 14,13 L 13,14"
                                              Stroke="{DynamicResource TextFillColorSecondaryBrush}"
                                              StrokeThickness="1.2"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Opacity="0.6"/>
                                    </Grid>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Grid>
                </Border>
            </modern:DropShadowPanel>
        </Popup>
    </Grid>
</Window>