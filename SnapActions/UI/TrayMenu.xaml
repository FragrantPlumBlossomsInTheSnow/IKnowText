<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- 托盘上下文菜单。菜单是真正的 WPF ContextMenu（由 H.NotifyIcon 的 TaskbarIcon 承载），
         条目用 WPF-UI 的 ui:MenuItem（Fluent 悬停/圆角/图标列），外层圆角+阴影的 chrome 在下面自己画 ——
         WPF-UI 4.3 只提供 MenuItem 模板，没有 ContextMenu 的外壳样式。

         改样式主要改这个文件：
           · 外壳：TrayMenuStyle（圆角 / 背景 / 边框 / 阴影 / 内边距 / 最小宽度 / 字号）
           · 条目：TrayMenuItemStyle（左右内边距、最小宽度）+ 每项的 ui:SymbolIcon
           · 分隔线：TraySeparatorStyle · 顶部状态行：TrayHeaderStyle（Tag="status"，文案由代码刷新）
           · 图标/文案/顺序直接改下面的元素；行为按 Tag 关联：enable / autostart / settings / exit
             （见 TrayMenu.xaml.cs，顺序和文案随便调，只要 Tag 保留） -->

    <Style x:Key="TrayMenuStyle" TargetType="{x:Type ContextMenu}">
        <Setter Property="MinWidth" Value="224" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HasDropShadow" Value="False" /> <!-- 阴影由模板里的 DropShadowEffect 负责 -->
        <Setter Property="Placement" Value="MousePoint" />
        <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border x:Name="MenuRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.30" Color="#000000" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TrayMenuItemStyle" TargetType="{x:Type ui:MenuItem}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MinWidth" Value="204" />
    </Style>

    <Style x:Key="TraySeparatorStyle" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="10,3" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="TrayHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="12,8,12,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <ContextMenu x:Key="TrayContextMenu" Style="{StaticResource TrayMenuStyle}">
        <!-- 顶部状态行（不可点击）：打开菜单时由 TrayMenu.xaml.cs 刷新为「已启用 / 已暂停」 -->
        <TextBlock Tag="status" Style="{StaticResource TrayHeaderStyle}" Text="SnapActions" />

        <Separator Style="{StaticResource TraySeparatorStyle}" />

        <ui:MenuItem Header="启用" Tag="enable" IsCheckable="True" Style="{StaticResource TrayMenuItemStyle}">
            <ui:MenuItem.Icon>
                <ui:SymbolIcon Symbol="Power24" FontSize="16" />
            </ui:MenuItem.Icon>
        </ui:MenuItem>

        <ui:MenuItem Header="开机自启" Tag="autostart" IsCheckable="True" Style="{StaticResource TrayMenuItemStyle}">
            <ui:MenuItem.Icon>
                <ui:SymbolIcon Symbol="Rocket24" FontSize="16" />
            </ui:MenuItem.Icon>
        </ui:MenuItem>

        <Separator Style="{StaticResource TraySeparatorStyle}" />

        <ui:MenuItem Header="设置…" Tag="settings" Style="{StaticResource TrayMenuItemStyle}">
            <ui:MenuItem.Icon>
                <ui:SymbolIcon Symbol="Settings24" FontSize="16" />
            </ui:MenuItem.Icon>
        </ui:MenuItem>

        <Separator Style="{StaticResource TraySeparatorStyle}" />

        <ui:MenuItem Header="退出" Tag="exit" Style="{StaticResource TrayMenuItemStyle}">
            <ui:MenuItem.Icon>
                <ui:SymbolIcon Symbol="ArrowExit24" FontSize="16" />
            </ui:MenuItem.Icon>
        </ui:MenuItem>
    </ContextMenu>

    <!-- 托盘图标本体。MenuActivation 默认就是 RightClick；双击开设置在 TrayMenu.xaml.cs 里挂
         TrayMouseDoubleClick。图标由代码设置（保留 pack 资源 → 文件 → 程序生成 三级回退），
         也可以改成在 XAML 里写 IconSource="/app.ico" 走声明式。 -->
    <tb:TaskbarIcon x:Key="TrayIcon"
                    ToolTipText="SnapActions"
                    NoLeftClickDelay="True"
                    ContextMenu="{StaticResource TrayContextMenu}" />

</ResourceDictionary>
